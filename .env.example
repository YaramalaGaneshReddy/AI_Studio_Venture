# Copy this file to .env and fill in your values

MONGODB_URI=your_mongodb_connection_string_here
JWT_SECRET=change-this-to-a-strong-random-secret
CLIENT_URL=http://localhost:5173
PORT=5001

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Option 1 (FAST - recommended): Get a free Gemini API key from https://aistudio.google.com/
# With this set, all 11 agents complete in ~15-30 seconds total instead of minutes.
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2 (LOCAL): Ollama running on your machine
# Start Ollama with: OLLAMA_NUM_PARALLEL=4 OLLAMA_MAX_LOADED_MODELS=1 ollama serve
# Pull models: ollama pull llama3 && ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FAST_MODEL=llama3.2:3b

# ── Search (optional — enables real-time market signals in agent prompts) ─────
# Get a free key from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ── Email (optional — enables sending reports via email) ──────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="AI Venture Studio <noreply@yourdomain.com>"
